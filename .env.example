# Required in a deployed backend
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b
FRONTEND_ORIGINS=https://your-vercel-app.vercel.app

# Optional Supabase Storage. Create a private bucket named documents.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=documents

# Local-only paths; hosted deployments use Supabase Storage.
DOCUMENT_ROOT=documents
STORAGE_ROOT=document_storage
MAX_UPLOAD_MB=100
